# Rust
/src-tauri/target
# Schemas de permissions regeneres a chaque compilation par tauri-build
/src-tauri/gen/schemas
**/*.rs.bk
*.pdb

# Frontend
/node_modules
/dist
*.local

# Configuration et modeles locaux, jamais versionnes
/.oyant-local/
*.bin
# Seule exception : le modele de detection de parole (885 Ko), integre a l'executable par
# `include_bytes!` et verifie par son empreinte dans `vad.rs`. Nomme exactement, pour qu'aucun
# autre `.bin` ne passe par cette porte.
!/src-tauri/vad/ggml-silero-v6.2.0.bin

# Secrets
.env
.env.*
!.env.example

# Captures de verification : elles montrent tout l'ecran, jamais versionnees
capture-*.png

# Moteur de transcription embarque, produit par scripts/preparer-moteur-embarque.py.
# Des binaires d'un tiers versionnes ici se perimeraient en silence et brouilleraient les
# differences ; le script fait autorite, et son empreinte attendue est le garde-fou.
src-tauri/moteur/
.scratch/

# Runtime Visual C++ embarque par l'installateur, rassemble par
# scripts/preparer-runtime-vcpp.py. Binaires Microsoft, pas a nous de les versionner.
src-tauri/runtime/
